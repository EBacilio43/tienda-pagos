# Imagen de desarrollo local — hot reload sobre el código bind-mounteado
# por docker-compose.yml. node:22-bookworm-slim (no Alpine, ver Dockerfile).
FROM node:22-bookworm-slim

# bookworm-slim no trae `openssl` — Prisma no puede detectar la versión de
# libssl y cae a un default que a veces no matchea el engine real.
RUN apt-get update && apt-get install -y --no-install-recommends openssl \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm install

COPY . .

EXPOSE 3000

CMD ["sh", "-c", "npx prisma generate && npx prisma migrate deploy && npm run dev"]
