#!/usr/bin/env sh
# . Corre la simulación del CI antes de dejar completar un push.
#
# Vive en .githooks/ (versionado) y no en .git/hooks/ (que no se versiona
# ni se clona). Se activa una sola vez por clon con:
#
#     git config core.hooksPath .githooks
#
# Escape: si de verdad hace falta pushear sin simular —Docker apagado, un
# push de una rama de respaldo, una emergencia— es
#
#     SALTAR_CI=1 git push
#
# a propósito explícito y no un flag fácil de teclear por reflejo. Saltarlo
# no es gratis: los dos fallos reales del CI (2026-08-11) solo se ven
# corriendo la secuencia completa.
set -eu

if [ "${SALTAR_CI:-0}" = "1" ]; then
  printf '\033[33m⚠ Simulación del CI saltada (SALTAR_CI=1). El push va a ciegas.\033[0m\n'
  exit 0
fi

printf '\033[1mSimulando el CI antes de pushear (~3 min)...\033[0m\n'
printf '  Para saltarlo: SALTAR_CI=1 git push\n'

if ! docker compose ps --status running --services 2>/dev/null | grep -q '^db$'; then
  printf '\033[31m✗ Docker no está arriba, no se puede simular el CI.\033[0m\n'
  printf '  Levántalo con "docker compose up -d", o pushea a ciegas con:\n'
  printf '      SALTAR_CI=1 git push\n'
  exit 1
fi

sh scripts/simular-ci.sh
