generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["views"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

model Cliente {
  id                   Int              @id @default(autoincrement())
  nombre               String           @db.VarChar(150)
  email                String?          @db.VarChar(150)
  telefono             String?          @db.VarChar(20)
  empresa              String?          @db.VarChar(150)
  calle                String?          @db.VarChar(200)
  numExt               String?          @map("num_ext") @db.VarChar(20)
  numInt               String?          @map("num_int") @db.VarChar(20)
  colonia              String?          @db.VarChar(100)
  municipio            String?          @db.VarChar(100)
  estado               String?          @db.VarChar(100)
  cp                   String?          @db.VarChar(10)
  fechaRegistro        DateTime?        @map("fecha_registro") @db.Timestamp(6)
  // CHECK clientes_no_auto_absorcion: absorbido_por IS DISTINCT FROM id ()
  absorbidoPor         Int?             @map("absorbido_por")
  fechaAbsorcion       DateTime?        @map("fecha_absorcion") @db.Timestamp(6)
  absorbidoPorCliente  Cliente?         @relation("ClienteAbsorcion", fields: [absorbidoPor], references: [id], onDelete: NoAction, onUpdate: NoAction)
  clientesAbsorbidos   Cliente[]        @relation("ClienteAbsorcion")
  devoluciones         Devolucion[]
  herenciasComoDestino HerenciaCuenta[] @relation("HerenciaDestino")
  herenciasComoOrigen  HerenciaCuenta[] @relation("HerenciaOrigen")
  pagos                Pago[]
  ventas               Venta[]

  // Migración integridad_dominio (Fase 4) — Fase 0 confirmó 0 duplicados en
  // producción, se puede aplicar sin reconciliación manual previa.
  @@unique([nombre])
  @@map("clientes")
}

model Catalogo {
  id            Int       @id @default(autoincrement())
  nombre        String    @db.VarChar(200)
  precio        Decimal?  @db.Decimal(12, 2)
  descripcion   String?
  activo        Boolean?
  fechaRegistro DateTime? @map("fecha_registro") @db.Timestamp(6)
  notas         String?
  stock         Int       @default(0)
  stockMinimo   Int       @default(0) @map("stock_minimo")

  movimientosStock    MovimientoStock[]
  ventaArticulos      VentaArticulo[]      @relation("VentaArticuloCatalogo")
  devolucionArticulos DevolucionArticulo[] @relation("DevolucionArticuloCatalogo")

  @@map("catalogo")
}

// AGENTS.md regla 4: único registro de cada variación de stock. Invariante:
// catalogo.stock == SUM(movimientos_stock.delta) para cada artículo.
// `referenciaTipo`/`referenciaId` quedan NULL para ajustes manuales y altas
// de catálogo (lo único que existe hasta Fase 3); Fase 4 los llena para
// ventas/devoluciones.
model MovimientoStock {
  id             Int      @id @default(autoincrement())
  idCatalogo     Int      @map("id_catalogo")
  tipo           String   @db.VarChar(50)
  referenciaTipo String?  @map("referencia_tipo") @db.VarChar(50)
  referenciaId   Int?     @map("referencia_id")
  delta          Int
  actorId        Int?     @map("actor_id")
  notas          String?
  creadoEn       DateTime @default(now()) @map("creado_en") @db.Timestamptz(6)

  catalogo Catalogo @relation(fields: [idCatalogo], references: [id], onDelete: NoAction, onUpdate: NoAction)
  actor    Usuario? @relation(fields: [actorId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([idCatalogo], map: "ix_movimientos_stock_id_catalogo")
  @@map("movimientos_stock")
}

model Venta {
  id                   Int             @id @default(autoincrement())
  idCliente            Int             @map("id_cliente")
  fecha                DateTime        @db.Date
  esquemaPago          String?         @map("esquema_pago") @db.VarChar(50)
  frecuenciaPago       String?         @map("frecuencia_pago") @db.VarChar(50)
  montoTotal           Decimal?        @map("monto_total") @db.Decimal(12, 2)
  tieneEnganche        Boolean?        @map("tiene_enganche")
  enganche             Decimal?        @db.Decimal(12, 2)
  fechaRegistroSistema DateTime?       @map("fecha_registro_sistema") @db.Timestamp(6)
  ventaArticulos       VentaArticulo[]
  cliente              Cliente         @relation(fields: [idCliente], references: [id], onDelete: NoAction, onUpdate: NoAction)

  // por aquí entran el detalle de cliente, el ledger y
  // v_saldos_cliente — sin índice, table scan en cuanto haya volumen.
  @@index([idCliente])
  @@index([fechaRegistroSistema])
  @@map("ventas")
}

model VentaArticulo {
  id             Int       @id @default(autoincrement())
  idVenta        Int       @map("id_venta")
  nombre         String    @db.VarChar(200)
  cantidad       Int?
  precioUnitario Decimal?  @map("precio_unitario") @db.Decimal(12, 2)
  idCatalogo     Int?      @map("id_catalogo")
  venta          Venta     @relation(fields: [idVenta], references: [id], onDelete: Cascade, onUpdate: NoAction)
  catalogo       Catalogo? @relation("VentaArticuloCatalogo", fields: [idCatalogo], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([idVenta])
  @@map("venta_articulos")
}

model Pago {
  id                   Int       @id @default(autoincrement())
  idCliente            Int       @map("id_cliente")
  fecha                DateTime  @db.Date
  monto                Decimal   @db.Decimal(12, 2)
  metodoPago           String?   @map("metodo_pago") @db.VarChar(50)
  referencia           String?   @db.VarChar(200)
  notas                String?
  fechaRegistroSistema DateTime? @map("fecha_registro_sistema") @db.Timestamp(6)
  cliente              Cliente   @relation(fields: [idCliente], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([idCliente])
  @@index([fechaRegistroSistema])
  @@map("pagos")
}

model Devolucion {
  id                   Int                  @id @default(autoincrement())
  idCliente            Int                  @map("id_cliente")
  fecha                DateTime             @db.Date
  motivo               String?
  fechaRegistroSistema DateTime?            @map("fecha_registro_sistema") @db.Timestamp(6)
  montoCredito         Decimal              @default(0) @map("monto_credito") @db.Decimal(12, 2)
  devolucionArticulos  DevolucionArticulo[]
  cliente              Cliente              @relation(fields: [idCliente], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([idCliente])
  @@index([fechaRegistroSistema])
  @@map("devoluciones")
}

model DevolucionArticulo {
  id             Int        @id @default(autoincrement())
  idDevolucion   Int        @map("id_devolucion")
  nombre         String     @db.VarChar(200)
  cantidad       Int?
  /// Precio al que la pieza se VENDIÓ. Es la identidad del artículo cuando
  /// no está ligado al catálogo (lib/articulos.ts), así que no se toca al
  /// acreditar de menos — para eso está `precioCredito`.
  precioUnitario Decimal?   @map("precio_unitario") @db.Decimal(12, 2)
  /// Lo que de verdad se le acredita al cliente por pieza, cuando difiere
  /// del precio de venta (la pieza vuelve con desgaste). NULL = se acredita
  /// al precio de venta, que es el caso normal.
  precioCredito  Decimal?   @map("precio_credito") @db.Decimal(12, 2)
  idCatalogo     Int?       @map("id_catalogo")
  devolucion     Devolucion @relation(fields: [idDevolucion], references: [id], onDelete: Cascade, onUpdate: NoAction)
  catalogo       Catalogo?  @relation("DevolucionArticuloCatalogo", fields: [idCatalogo], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([idDevolucion])
  @@map("devolucion_articulos")
}

model HerenciaCuenta {
  id               Int       @id @default(autoincrement())
  idClienteOrigen  Int       @map("id_cliente_origen")
  idClienteDestino Int       @map("id_cliente_destino")
  fechaHerencia    DateTime? @map("fecha_herencia") @db.Timestamp(6)
  notas            String?
  clienteDestino   Cliente   @relation("HerenciaDestino", fields: [idClienteDestino], references: [id], onDelete: NoAction, onUpdate: NoAction)
  clienteOrigen    Cliente   @relation("HerenciaOrigen", fields: [idClienteOrigen], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("herencias_cuenta")
}

model Usuario {
  id               Int               @id @default(autoincrement())
  username         String            @unique(map: "ix_usuarios_username") @db.VarChar(50)
  passwordHash     String            @map("password_hash") @db.VarChar(255)
  nombreCompleto   String            @map("nombre_completo") @db.VarChar(100)
  email            String?           @unique @db.VarChar(120)
  rol              String            @db.VarChar(20)
  activo           Boolean
  intentosFallidos Int               @map("intentos_fallidos")
  bloqueadoHasta   DateTime?         @map("bloqueado_hasta") @db.Timestamp(6)
  ultimoLogin      DateTime?         @map("ultimo_login") @db.Timestamp(6)
  ultimaActividad  DateTime?         @map("ultima_actividad") @db.Timestamp(6)
  creadoEn         DateTime          @map("creado_en") @db.Timestamp(6)
  actualizadoEn    DateTime?         @map("actualizado_en") @db.Timestamp(6)
  auditorias       Auditoria[]
  sesiones         Sesion[]
  sesionesLog      SesionLog[]
  movimientosStock MovimientoStock[]

  @@map("usuarios")
}

model Sesion {
  id              Int      @id @default(autoincrement())
  usuarioId       Int      @map("usuario_id")
  tokenHash       String   @unique @map("token_hash") @db.VarChar(64)
  creadaEn        DateTime @default(now()) @map("creada_en") @db.Timestamptz(6)
  expiraEn        DateTime @map("expira_en") @db.Timestamptz(6)
  ultimaActividad DateTime @default(now()) @map("ultima_actividad") @db.Timestamptz(6)
  ipAddress       String?  @map("ip_address") @db.VarChar(45)
  userAgent       String?  @map("user_agent")
  usuario         Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([usuarioId], map: "ix_sesiones_usuario_id")
  @@map("sesiones")
}

model SesionLog {
  id                Int      @id @default(autoincrement())
  usuarioId         Int?     @map("usuario_id")
  usernameIntentado String   @map("username_intentado") @db.VarChar(50)
  ipAddress         String?  @map("ip_address") @db.VarChar(45)
  userAgent         String?  @map("user_agent")
  exitoso           Boolean
  motivoFalla       String?  @map("motivo_falla") @db.VarChar(100)
  timestamp         DateTime @db.Timestamp(6)
  usuario           Usuario? @relation(fields: [usuarioId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([timestamp], map: "ix_sesiones_log_timestamp")
  @@map("sesiones_log")
}

model Auditoria {
  id              Int      @id @default(autoincrement())
  usuarioId       Int?     @map("usuario_id")
  accion          String   @db.VarChar(50)
  tablaAfectada   String   @map("tabla_afectada") @db.VarChar(50)
  registroId      String?  @map("registro_id") @db.VarChar(50)
  datosAnteriores Json?    @map("datos_anteriores") @db.Json
  datosNuevos     Json?    @map("datos_nuevos") @db.Json
  ipAddress       String?  @map("ip_address") @db.VarChar(45)
  timestamp       DateTime @db.Timestamp(6)
  usuario         Usuario? @relation(fields: [usuarioId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([timestamp], map: "ix_auditoria_timestamp")
  @@map("auditoria")
}

view VSaldoCliente {
  clienteId Int      @unique @map("cliente_id")
  saldo     Decimal? @db.Decimal(12, 2)

  @@map("v_saldos_cliente")
}

model IdempotenciaToken {
  token    String   @id @db.VarChar(64)
  accion   String   @db.VarChar(64)
  expiraEn DateTime @map("expira_en") @db.Timestamptz(6)
  creadoEn DateTime @default(now()) @map("creado_en") @db.Timestamptz(6)

  @@index([expiraEn], map: "ix_idempotencia_tokens_expira_en")
  @@map("idempotencia_tokens")
}

