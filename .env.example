# Conexión a PostgreSQL (local vía docker o remota)
DATABASE_URL="postgresql://tienda:tienda@localhost:5433/tienda"
DIRECT_DATABASE_URL="postgresql://tienda:tienda@localhost:5433/tienda"

# Secreto de sesión — aleatorio, largo, sin valor por defecto.
# La app se rehúsa a arrancar si esta variable falta (ver AGENTS.md).
# Generar con: openssl rand -base64 32
SESSION_SECRET=

NODE_ENV=development
